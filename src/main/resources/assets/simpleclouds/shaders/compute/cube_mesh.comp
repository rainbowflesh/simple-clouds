float getLayerScrollSpeedFactor(NoiseLayer layer)
{
	return 1.0;
}

float getNoiseForLayer(NoiseLayer layer, float x, float y, float z, out vec3 gradient)
{
	if (y < layer.HeightOffset || y > layer.HeightOffset + layer.Height - 1)
		return -10000.0;
	vec3 scale = vec3(layer.ScaleX, layer.ScaleY, layer.ScaleZ);
	float layerSpeedFactor = getLayerScrollSpeedFactor(layer);
	vec3 scrollScaled = (Scroll * layerSpeedFactor) / scale;
	vec3 samplePos = vec3(x, y, z) / scale + scrollScaled;
	float noise = psrdnoise(samplePos, TILE_PERIOD, Wiggle, gradient) * layer.ValueScale + layer.ValueOffset;
	float heightDelta = y - layer.HeightOffset;
	noise -= 1.0 - clamp(heightDelta / layer.FadeDistance, 0.0, 1.0);
	noise -= 1.0 - clamp((layer.Height - heightDelta) / layer.FadeDistance, 0.0, 1.0);
	return noise;
}

float getNoiseForLayerGroup(LayerGroup group, float x, float y, float z, out vec3 gradient)
{
	int totalLayers = group.EndIndex - group.StartIndex;
	if (totalLayers == 0)
	{
		return -10000.0;
	}
	else if (totalLayers == 1)
	{
		return getNoiseForLayer(layers.data[group.StartIndex], x, y, z, gradient);
	}
	else
	{
		vec3 finalGradient = vec3(0.0);
		float combinedNoise = 0.0;
		bool anyValid = false;
		for (int i = 0; i < totalLayers; i++)
		{
			vec3 gradForLayer = vec3(0.0);
			float valForLayer = getNoiseForLayer(layers.data[i + group.StartIndex], x, y, z, gradForLayer);
			if (valForLayer > -10.0)
			{
				combinedNoise += valForLayer;
				finalGradient += gradForLayer;
				anyValid = true;
			}
		}
		gradient = finalGradient;
		if (anyValid)
			return combinedNoise;
		else
			return -10000.0;
	}
	return 0.0;
}
int getPackedRegionLayer(float y)
{
	return LodLevel;
}

#if TYPE == 0
vec4 sampleRegionInfo(float y, int nx, int nz)
{
	vec2 texelCoord = gl_GlobalInvocationID.xz + RegionSampleOffset + vec2(nx, nz);
	return texture(RegionsSampler, vec3(texelCoord / RegionsTexSize, float(getPackedRegionLayer(y))));
}

bool hasRegionInfo(vec4 info)
{
	return info.g > 0.0;
}
#endif

bool isPosValid(float x, float y, float z, LayerGroup group, float fade)
{
	vec3 gradient = vec3(0.0);
	return getNoiseForLayerGroup(group, x, y, z, gradient) + fade > 0.0;
}

float getRegionFade(float visibility)
{
	return -5.0 * pow(1.0 - visibility, 10.0);
}

float getConservativeCellDistance(float x, float z)
{
	vec2 center = vec2(x, z) + vec2(Scale * 0.5);
	float cellRadius = Scale * 0.70710677;
	return max(distance(center, Origin.xz) - cellRadius, 0.0);
}

#if TYPE == 1 || FADE_NEAR_ORIGIN == 1
float getDistanceFadeForCell(float x, float z)
{
	float len = getConservativeCellDistance(x, z);
	return -5.0 * min(max(len - FadeStart, 0.0) / (FadeEnd - FadeStart), 1.0);
}
#endif

bool isPosValid(float x, float y, float z, int nx, int nz)
{
#if TYPE == 0
	vec4 info = sampleRegionInfo(y, nx, nz);
	if (!hasRegionInfo(info))
		return false;
    uint regionId = uint(info.r);
    LayerGroup group = layerGroupings.data[regionId];
	float fade = getRegionFade(info.g);
#if FADE_NEAR_ORIGIN == 1
	fade = min(fade, getDistanceFadeForCell(x, z));
#endif
#elif TYPE == 1
	LayerGroup group = layerGroupings.data[0];
	float fade = getDistanceFadeForCell(x, z);
#endif
    return isPosValid(x, y, z, group, fade);
}

#if TRANSPARENCY == 1
bool isTransparentPosValid(float x, float y, float z, LayerGroup group, float fade)
{
	vec3 gradient = vec3(0.0);
	return getNoiseForLayerGroup(group, x, y, z, gradient) + fade > -ShellFade;
}

bool isTransparentPosValid(float x, float y, float z, int nx, int nz)
{
#if TYPE == 0
	vec4 info = sampleRegionInfo(y, nx, nz);
	if (!hasRegionInfo(info))
		return false;
	uint regionId = uint(info.r);
	LayerGroup group = layerGroupings.data[regionId];
	float fade = getRegionFade(info.g);
#if FADE_NEAR_ORIGIN == 1
	fade = min(fade, getDistanceFadeForCell(x, z));
#endif
#elif TYPE == 1
	LayerGroup group = layerGroupings.data[0];
	float fade = getDistanceFadeForCell(x, z);
#endif
	return isTransparentPosValid(x, y, z, group, fade);
}

bool shouldNotOcclude(int index);

int getTransparencySupportDepth()
{
	return clamp(ShellSupportDepth, 1, 6);
}

bool isOpaqueAtTransparencyOffset(float x, float y, float z, LayerGroup group, float fade, ivec3 offset)
{
	float sampleX = x + Scale * float(offset.x);
	float sampleY = y + Scale * float(offset.y);
	float sampleZ = z + Scale * float(offset.z);
#if TYPE == 0
	if (offset.x != 0 || offset.z != 0)
		return isPosValid(sampleX, sampleY, sampleZ, offset.x, offset.z);
#endif
	return isPosValid(sampleX, sampleY, sampleZ, group, fade);
}

bool isTransparentAtTransparencyOffset(float x, float y, float z, LayerGroup group, float fade, ivec3 offset)
{
	float sampleX = x + Scale * float(offset.x);
	float sampleY = y + Scale * float(offset.y);
	float sampleZ = z + Scale * float(offset.z);
#if TYPE == 0
	if (offset.x != 0 || offset.z != 0)
		return isTransparentPosValid(sampleX, sampleY, sampleZ, offset.x, offset.z);
#endif
	return isTransparentPosValid(sampleX, sampleY, sampleZ, group, fade);
}

bool traceTransparentSupportRay(float x, float y, float z, LayerGroup group, float fade, ivec3 startOffset, ivec3 direction, int maxSteps)
{
	ivec3 offset = startOffset;
	for (int step = 1; step <= maxSteps; step++)
	{
		offset += direction;
		if (isOpaqueAtTransparencyOffset(x, y, z, group, fade, offset))
			return true;
		if (!isTransparentAtTransparencyOffset(x, y, z, group, fade, offset))
			return false;
	}
	return false;
}

bool hasTransparentSupport(float x, float y, float z, LayerGroup group, float fade, int maxSteps)
{
	for (int primaryIndex = 0; primaryIndex < 6; primaryIndex++)
	{
		ivec3 primaryDirection = SUPPORT_DIRECTIONS[primaryIndex];
		ivec3 offset = ivec3(0);
		for (int primaryStep = 1; primaryStep <= maxSteps; primaryStep++)
		{
			offset += primaryDirection;
			if (isOpaqueAtTransparencyOffset(x, y, z, group, fade, offset))
				return true;
			if (!isTransparentAtTransparencyOffset(x, y, z, group, fade, offset))
				break;

			int remainingSteps = maxSteps - primaryStep;
			for (int bendIndex = 0; bendIndex < 6; bendIndex++)
			{
				ivec3 bendDirection = SUPPORT_DIRECTIONS[bendIndex];
				if (all(equal(bendDirection, primaryDirection)) || all(equal(bendDirection, -primaryDirection)))
					continue;
				if (traceTransparentSupportRay(x, y, z, group, fade, offset, bendDirection, remainingSteps))
					return true;
			}
		}
	}
	return false;
}

bool isTransparentCubeVisible(float x, float y, float z, LayerGroup group, float fade)
{
	if (shouldNotOcclude(0) || shouldNotOcclude(1) || shouldNotOcclude(2) || shouldNotOcclude(3)
			|| shouldNotOcclude(4) || shouldNotOcclude(5))
		return true;

	bool negYOpaque = isPosValid(x, y - Scale, z, group, fade);
	bool posYOpaque = isPosValid(x, y + Scale, z, group, fade);
	bool negXOpaque = isPosValid(x - Scale, y, z, -1, 0);
	bool posXOpaque = isPosValid(x + Scale, y, z, 1, 0);
	bool negZOpaque = isPosValid(x, y, z - Scale, 0, -1);
	bool posZOpaque = isPosValid(x, y, z + Scale, 0, 1);

	bool hasAdjacentOpaque = negYOpaque || posYOpaque || negXOpaque || posXOpaque || negZOpaque || posZOpaque;
	if (!hasAdjacentOpaque)
	{
		int supportDepth = getTransparencySupportDepth();
		if (!hasTransparentSupport(x, y, z, group, fade, supportDepth))
			return false;
	}

	bool negYFilled = negYOpaque || isTransparentPosValid(x, y - Scale, z, group, fade);
	bool posYFilled = posYOpaque || isTransparentPosValid(x, y + Scale, z, group, fade);
	bool negXFilled = negXOpaque || isTransparentPosValid(x - Scale, y, z, -1, 0);
	bool posXFilled = posXOpaque || isTransparentPosValid(x + Scale, y, z, 1, 0);
	bool negZFilled = negZOpaque || isTransparentPosValid(x, y, z - Scale, 0, -1);
	bool posZFilled = posZOpaque || isTransparentPosValid(x, y, z + Scale, 0, 1);

	return !(negYFilled && posYFilled && negXFilled && posXFilled && negZFilled && posZFilled);
}

#endif

bool shouldNotOcclude(int index)
{
	if ((DoNotOccludeSideMask & (1 << index)) != 0)
	{
		vec3 id = gl_GlobalInvocationID;
		vec3 size = gl_NumWorkGroups * LOCAL_SIZE;
		if (index == 1)
			return id.x == size.x - 1.0;
		else if (index == 0)
			return id.x == 0.0;
		else if (index == 3)
			return id.y == size.y - 1.0;
		else if (index == 2)
			return id.y == 0.0;
		else if (index == 5)
			return id.z == size.z - 1.0;
		else if (index == 4)
			return id.z == 0.0;
		else
			return false;			
	}
	else
	{
		return false;
	}
}

float getTransparentAlphaFactor(float y)
{
	return 1.0;
}

float hashCloudTint(vec3 pos)
{
	vec3 cell = floor(pos / max(Scale * 6.0, 24.0));
	return fract(sin(dot(cell, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

vec3 getRainbowTint(vec3 pos)
{
	float value = hashCloudTint(pos);
	if (value < 1.0 / 7.0)
		return vec3(1.0, 0.58, 0.58);
	if (value < 2.0 / 7.0)
		return vec3(1.0, 0.72, 0.5);
	if (value < 3.0 / 7.0)
		return vec3(1.0, 0.92, 0.56);
	if (value < 4.0 / 7.0)
		return vec3(0.62, 0.94, 0.62);
	if (value < 5.0 / 7.0)
		return vec3(0.58, 0.76, 1.0);
	if (value < 6.0 / 7.0)
		return vec3(0.72, 0.62, 0.94);
	return vec3(0.9, 0.66, 1.0);
}

vec3 getCloudTint(LayerGroup group, vec3 pos)
{
	if (group.ColorMode < 0.5)
		return vec3(1.0);
	if (group.ColorMode < 1.5)
		return vec3(group.TintR, group.TintG, group.TintB);
	return getRainbowTint(pos);
}

float getDensityFactor(float noise)
{
	return clamp(noise / DENSITY_SHADE_RANGE, 0.0, 1.0);
}

float applyDensityBrightness(float brightness, float density)
{
	float densityBrightness = mix(DENSITY_BRIGHT_EDGE, DENSITY_BRIGHT_CORE, density);
	return clamp(brightness * densityBrightness, 0.0, 1.0);
}

// ----- Opaque -----

void createFace(vec3 center, float cubeRadius, int index, float brightness, vec3 tint)
{
#if FIXED_SECTION_SIZE == 0
	atomicAdd(sidesPerChunk.data[ChunkIndex], 1u);
	uint currentFace = atomicAdd(totalSides, 1u);
#elif FIXED_SECTION_SIZE == 1
	uint currentFace = atomicAdd(sidesPerChunk.data[ChunkIndex], 1u);
#endif
	SideInfo side;
	side.side = index;
	side.x = center.x;
	side.y = center.y;
	side.z = center.z;
	side.brightness = brightness;
	side.radius = cubeRadius;
	side.tintR = tint.r;
	side.tintG = tint.g;
	side.tintB = tint.b;
#if FIXED_SECTION_SIZE == 0
	sides.data[currentFace] = side;
#elif FIXED_SECTION_SIZE == 1
	sides.data[OpaqueMeshDataOffset + currentFace] = side;
#endif
}

	void createCube(float x, float y, float z, float cubeRadius, float brightness, float density, float fade, LayerGroup group)
{
	vec3 pos = vec3(x, y, z);
	vec3 norm = vec3(0.0);
	if (!TestFacesFacingAway)
		norm = normalize(pos - Origin);
	vec3 center = pos + cubeRadius;
	vec3 tint = mix(vec3(1.0), getCloudTint(group, center), mix(DENSITY_TINT_MIN, 1.0, density));
	//-Y
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, -1.0, 0.0)) <= 0.0) && (!isPosValid(x, y - Scale, z, group, fade) || shouldNotOcclude(2)))
		createFace(center, cubeRadius, 2, brightness, tint);
	//+Y
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 1.0, 0.0)) <= 0.0) && (!isPosValid(x, y + Scale, z, group, fade) || shouldNotOcclude(3)))
		createFace(center, cubeRadius, 3, brightness, tint);
	//-X
	if ((TestFacesFacingAway || dot(norm, vec3(-1.0, 0.0, 0.0)) <= 0.0) && (!isPosValid(x - Scale, y, z, -1, 0) || shouldNotOcclude(0)))
		createFace(center, cubeRadius, 0, brightness, tint);
	//+X
	if ((TestFacesFacingAway || dot(norm, vec3(1.0, 0.0, 0.0)) <= 0.0) && (!isPosValid(x + Scale, y, z, 1, 0) || shouldNotOcclude(1)))
		createFace(center, cubeRadius, 1, brightness, tint);
	//-Z
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, -1.0)) <= 0.0) && (!isPosValid(x, y, z - Scale, 0, -1) || shouldNotOcclude(4)))
		createFace(center, cubeRadius, 4, brightness, tint);
	//+Z
	if ((TestFacesFacingAway || dot(norm, vec3(0.0, 0.0, 1.0)) <= 0.0) && (!isPosValid(x, y, z + Scale, 0, 1) || shouldNotOcclude(5)))
		createFace(center, cubeRadius, 5, brightness, tint);
}

// ----- Transparent -----

#if TRANSPARENCY == 1

void createTransparentCube(float x, float y, float z, float cubeRadius, float brightness, float alpha, vec3 tint)
{
	atomicAdd(transparentCubesPerChunk.data[ChunkIndex], 1u);
#if FIXED_TRANSPARENCY_SECTION_SIZE == 0
	uint currentCube = atomicAdd(totalTransparentCubes, 1u);
#elif FIXED_TRANSPARENCY_SECTION_SIZE == 1
	uint currentCube = atomicAdd(transparentCubesPerChunk.data[ChunkIndex], 1u);
#endif
	if (currentCube >= uint(TransparentMeshDataLimit))
		return;
	TransparentCubeInfo cube;
	cube.x = x + cubeRadius;
	cube.y = y + cubeRadius;
	cube.z = z + cubeRadius;
	cube.brightness = brightness;
	cube.alpha = alpha;
	cube.radius = cubeRadius;
	cube.tintR = tint.r;
	cube.tintG = tint.g;
	cube.tintB = tint.b;
	#if FIXED_TRANSPARENCY_SECTION_SIZE == 0
	cubesTransparent.data[currentCube] = cube;
	#elif FIXED_TRANSPARENCY_SECTION_SIZE == 1
	cubesTransparent.data[TransparentMeshDataOffset + currentCube] = cube;
#endif
}

float getTransparentAlphaThreshold()
{
	return min(max(ShellFade * 0.25, MIN_TRANSPARENT_ALPHA), 0.05);
}

#endif

// -----------------------

void main() 
{
    vec3 id = gl_GlobalInvocationID;
    float x = id.x * Scale + RenderOffset.x;
    float y = id.y * Scale + RenderOffset.y;
    float z = id.z * Scale + RenderOffset.z;
    
#if TYPE == 0
	vec4 info = sampleRegionInfo(y, 0, 0);
	if (!hasRegionInfo(info))
		return;
    uint regionId = uint(info.r);
    LayerGroup group = layerGroupings.data[regionId];
	float fade = getRegionFade(info.g);
#if FADE_NEAR_ORIGIN == 1
	fade = min(fade, getDistanceFadeForCell(x, z));
#endif
#elif TYPE == 1
	LayerGroup group = layerGroupings.data[0];
	float fade = getDistanceFadeForCell(x, z);
#endif
	vec3 gradient = vec3(0.0);
	float noise = getNoiseForLayerGroup(group, x, y, z, gradient) + fade;
	float storminess = clamp(group.Storminess + fade * 0.1, 0.0, 1.0);
	float brightness = clamp(1.0 - storminess * (1.0 - clamp((y - group.StormStart) / group.StormFadeDistance, 0.0, 1.0)), 0.0, 1.0);
#if STYLE == 1
	gradient = normalize(gradient);
	float strength = dot(gradient, SHADE_DIRECTION) * 0.5 + 0.5;
	brightness = clamp(brightness - strength * 0.1, 0.0, 1.0);
#endif
	float density = getDensityFactor(noise);
	brightness = applyDensityBrightness(brightness, density);
    if (noise > 0.0)
    {
	    	createCube(x, y, z, Scale / 2.0, brightness, density, fade, group);
    }
#if TRANSPARENCY == 1
    else if (noise > -ShellFade && noise < 0.0)
    {
	   	float length = getConservativeCellDistance(x, z);
   		if (length < TransparencyDistance)
   		{
				vec3 center = vec3(x, y, z) + Scale / 2.0;
				float alpha = smoothstep(0.0, 1.0, 1.0 / ShellFade * (noise + ShellFade));
				alpha *= getTransparentAlphaFactor(y);
				float minTransparentAlpha = getTransparentAlphaThreshold();
	    		vec3 tint = mix(vec3(1.0), getCloudTint(group, center), DENSITY_TINT_MIN);
	    		if (alpha >= minTransparentAlpha && isTransparentCubeVisible(x, y, z, group, fade))
	    			createTransparentCube(x, y, z, Scale / 2.0, brightness, alpha, tint);
   		}
		else
		{
			createCube(x, y, z, Scale / 2.0, brightness, density, fade, group);
		}
    }
#endif
}